<%- include('head.partial.ejs') %>
<div class="container">
  <h1><%= album.title %></h1>

  <div class="section album-details">
    <p><strong>Artysta:</strong> <%= album.artist %></p>
    <p><strong>Data Wydania:</strong> <%= album.releaseDate %></p>
    <p><strong>Całkowity Czas Trwania:</strong> <%= album.totalDuration %></p>
    <p><strong>Posłuchaj na Spotify:</strong> <a href="<%= album.spotifyLink %>" target="_blank" class="spotify-link">Otwórz w Spotify</a></p>
    <p><strong>Opis:</strong> <%= album.description %></p>
  </div>

  <% if (user && user.is_admin) { %>
    <div class="section album-actions">
      <a href="/edit-album/<%= album.id %>" class="action-button">Edytuj album</a>
      <form action="/delete-album/<%= album.id %>" method="POST" style="display:inline; margin-left: 10px;">
        <button type="submit" class="action-button" onclick="return confirm('Czy na pewno chcesz usunąć album?');">Usuń album</button>
      </form>
    </div>
  <% } %>

  <div class="section album-songs">
    <h2>Piosenki:</h2>
    <ul>
      <% album.songs.forEach(song => { %>
        <li><%= song.title %></li>
      <% }); %>
    </ul>
  </div>

  <div class="section comments">
    <h2>Komentarze:</h2>
    <% if (comments.length > 0) { %>
      <ul>
        <% comments.forEach(c => { %>
          <li>
            <strong><%= new Date(c.created_at).toLocaleString() %> <%= c.username ? '(' + c.username + ')' : '' %>:</strong>
            <%= c.content %>
            <% if (user && (user.is_admin || c.user_id === user.id)) { %>
              <form action="/delete-comment/<%= c.id %>" method="POST" style="display:inline; margin-left:10px;">
                <button type="submit">Usuń</button>
              </form>
            <% } %>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <p>Brak komentarzy.</p>
    <% } %>

    <% if (user) { %>
      <h3>Dodaj Komentarz:</h3>
      <form action="/add-comment" method="POST">
        <input type="hidden" name="albumId" value="<%= album.id %>">
        <textarea name="comment" required placeholder="Wpisz swój komentarz..."></textarea><br><br>
        <button type="submit">Dodaj Komentarz</button>
      </form>
    <% } else { %>
      <p>Musisz być <a href="/auth/login">zalogowany</a>, aby dodać komentarz.</p>
    <% } %>
  </div>

  <a href="/" class="back-link">Powrót do Poleceń</a>
</div>
<%- include('foot.partial.ejs') %>